# Copy to .env (git-ignored). Scripts that need keys source this file at runtime.
# Never commit real keys. Which voice a client uses is client knowledge
# (client agents/rules/10-brand.md); the key itself belongs here.

# ElevenLabs text-to-speech (voiceover pipeline, optional). Without it the
# pipeline uses the free local Piper voice. Voices are presets: the client's
# src/brand/voices.json names provider and voice id; scripts only name a preset.
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Optional: media generation MCP (kie.ai) if ever enabled
KIE_API_KEY=
